# ========== 全局默认规则 ==========
# 自动识别文本文件，统一使用 LF 换行符
* text=auto eol=lf

# ========== 代码与脚本文件 ==========
*.cs         text eol=lf
*.shader     text eol=lf
*.cginc      text eol=lf
*.hlsl       text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.txt        text eol=lf
*.md         text eol=lf

# ========== Unity 序列化文本文件 ==========
*.unity      text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.prefab     text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf
*.guiskin    text eol=lf
*.fontsettings text eol=lf

# ========== 二进制文件（禁止转换换行符） ==========
# 图片
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.tga  binary
*.psd  binary
*.tif  binary

# 音视频
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aac  binary
*.mp4  binary
*.avi  binary

# 模型与字体
*.fbx  binary
*.obj  binary
*.3ds  binary
*.ttf  binary
*.otf  binary

# 其他
*.dll  binary
*.exe  binary
*.zip  binary
*.bytes binary
*.so   binary
*.dylib binary
